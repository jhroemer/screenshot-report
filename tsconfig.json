{
  "compilerOptions": {
    "target": "es2022",
    "module": "node18",
    "moduleResolution": "node16",
    "types": ["node"],
    "declaration": true,
    "outDir": "./lib",
    "rootDir": ".",
    "isolatedModules": true,
    "isolatedDeclarations": false,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "sourceMap": false
  },
  "include": ["src", "tests", "test-project", "playwright.config.ts"]
}
